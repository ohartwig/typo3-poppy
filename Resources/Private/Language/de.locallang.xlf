<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="EXT:koh_poppy/Resources/Private/Language/locallang.xlf" product-name="koh_poppy">
        <body>
            <trans-unit id="scope.poppy_read" resname="scope.poppy_read">
                <source>See your account, your orders and your data on this site</source>
                <target>Ihr Konto, Ihre Bestellungen und Ihre Daten auf dieser Website ansehen</target>
            </trans-unit>
            <trans-unit id="scope.poppy_write" resname="scope.poppy_write">
                <source>Act on your behalf and change things in your account</source>
                <target>In Ihrem Namen handeln und Dinge in Ihrem Konto ändern</target>
            </trans-unit>
            <trans-unit id="consent.title" resname="consent.title">
                <source>Connect a personal agent</source>
                <target>Persönlichen Agenten verbinden</target>
            </trans-unit>
            <trans-unit id="consent.intro" resname="consent.intro">
                <source>A personal agent wants to act for you at %1$s. You are signed in as %2$s.</source>
                <target>Ein persönlicher Agent möchte für Sie bei %1$s handeln. Sie sind angemeldet als %2$s.</target>
            </trans-unit>
            <trans-unit id="consent.publishedOn" resname="consent.publishedOn">
                <source>published on %1$s</source>
                <target>veröffentlicht auf %1$s</target>
            </trans-unit>
            <trans-unit id="consent.scopes" resname="consent.scopes">
                <source>What the agent may do</source>
                <target>Was der Agent darf</target>
            </trans-unit>
            <trans-unit id="consent.returnTo" resname="consent.returnTo">
                <source>Afterwards you return to %1$s.</source>
                <target>Danach geht es zurück zu %1$s.</target>
            </trans-unit>
            <trans-unit id="consent.revokeHint" resname="consent.revokeHint">
                <source>You can disconnect the agent at any time on /poppy/account/agents.</source>
                <target>Sie können den Agenten jederzeit unter /poppy/account/agents trennen.</target>
            </trans-unit>
            <trans-unit id="consent.approve" resname="consent.approve">
                <source>Allow</source>
                <target>Erlauben</target>
            </trans-unit>
            <trans-unit id="consent.deny" resname="consent.deny">
                <source>Decline</source>
                <target>Ablehnen</target>
            </trans-unit>
            <trans-unit id="device.title" resname="device.title">
                <source>Enter code</source>
                <target>Code eingeben</target>
            </trans-unit>
            <trans-unit id="device.intro" resname="device.intro">
                <source>Enter the code your personal agent shows for %1$s.</source>
                <target>Geben Sie den Code ein, den Ihr persönlicher Agent für %1$s anzeigt.</target>
            </trans-unit>
            <trans-unit id="device.code" resname="device.code">
                <source>Code</source>
                <target>Code</target>
            </trans-unit>
            <trans-unit id="device.continue" resname="device.continue">
                <source>Continue</source>
                <target>Weiter</target>
            </trans-unit>
            <trans-unit id="device.checkCode" resname="device.checkCode">
                <source>Compare the code %1$s with the one your agent shows. Only allow if you started this sign-in yourself.</source>
                <target>Vergleichen Sie den Code %1$s mit dem, den Ihr Agent anzeigt. Erlauben Sie nur, wenn Sie die Anmeldung selbst gestartet haben.</target>
            </trans-unit>
            <trans-unit id="device.unknown" resname="device.unknown">
                <source>This code is unknown or has expired.</source>
                <target>Dieser Code ist unbekannt oder abgelaufen.</target>
            </trans-unit>
            <trans-unit id="device.tooMany" resname="device.tooMany">
                <source>Too many attempts. Please wait a few minutes.</source>
                <target>Zu viele Versuche. Bitte warten Sie einige Minuten.</target>
            </trans-unit>
            <trans-unit id="device.approved" resname="device.approved">
                <source>Agent connected</source>
                <target>Agent verbunden</target>
            </trans-unit>
            <trans-unit id="device.approvedText" resname="device.approvedText">
                <source>%1$s can now act for you within what you allowed. You can close this window.</source>
                <target>%1$s kann jetzt in dem erlaubten Umfang für Sie handeln. Sie können dieses Fenster schließen.</target>
            </trans-unit>
            <trans-unit id="device.denied" resname="device.denied">
                <source>Declined</source>
                <target>Abgelehnt</target>
            </trans-unit>
            <trans-unit id="device.deniedText" resname="device.deniedText">
                <source>%1$s gets no access to your account.</source>
                <target>%1$s erhält keinen Zugriff auf Ihr Konto.</target>
            </trans-unit>
            <trans-unit id="account.title" resname="account.title">
                <source>Connected agents</source>
                <target>Verbundene Agenten</target>
            </trans-unit>
            <trans-unit id="account.intro" resname="account.intro">
                <source>Personal agents you connected to your account. Disconnecting ends their access at once.</source>
                <target>Persönliche Agenten, die Sie mit Ihrem Konto verbunden haben. Trennen beendet ihren Zugriff sofort.</target>
            </trans-unit>
            <trans-unit id="account.none" resname="account.none">
                <source>No agent is connected to your account.</source>
                <target>Kein Agent ist mit Ihrem Konto verbunden.</target>
            </trans-unit>
            <trans-unit id="account.since" resname="account.since">
                <source>connected since %1$s</source>
                <target>verbunden seit %1$s</target>
            </trans-unit>
            <trans-unit id="account.disconnect" resname="account.disconnect">
                <source>Disconnect</source>
                <target>Trennen</target>
            </trans-unit>
            <trans-unit id="error.title" resname="error.title">
                <source>That did not work</source>
                <target>Das hat nicht geklappt</target>
            </trans-unit>
            <trans-unit id="feedback.title" resname="feedback.title">
                <source>Feedback from personal agents</source>
                <target>Feedback von persönlichen Agenten</target>
            </trans-unit>
            <trans-unit id="feedback.intro" resname="feedback.intro">
                <source>Tasks agents could not do on these sites. The text is the agents' own and unverified.</source>
                <target>Aufgaben, die Agenten auf diesen Websites nicht erledigen konnten. Der Text stammt von den Agenten selbst und ist ungeprüft.</target>
            </trans-unit>
            <trans-unit id="feedback.received" resname="feedback.received">
                <source>Received</source>
                <target>Eingang</target>
            </trans-unit>
            <trans-unit id="feedback.task" resname="feedback.task">
                <source>Task</source>
                <target>Aufgabe</target>
            </trans-unit>
            <trans-unit id="feedback.description" resname="feedback.description">
                <source>Description</source>
                <target>Beschreibung</target>
            </trans-unit>
            <trans-unit id="feedback.agent" resname="feedback.agent">
                <source>Agent</source>
                <target>Agent</target>
            </trans-unit>
            <trans-unit id="feedback.none" resname="feedback.none">
                <source>No feedback yet.</source>
                <target>Noch kein Feedback.</target>
            </trans-unit>
        </body>
    </file>
</xliff>
